# GoDaddy Secure Automation — Environment Template
# Copy to .env and fill with your real values. NEVER commit .env

# Get these from https://developer.godaddy.com/ (start with OTE/test environment)
GODADDY_API_KEY=your_api_key_here
GODADDY_API_SECRET=your_api_secret_here

# Use OTE for testing: https://api.ote.godaddy.com/v1
# Production: https://api.godaddy.com/v1
GODADDY_BASE_URL=https://api.ote.godaddy.com/v1

# Optional: comma-separated list of domains to focus on
# DOMAINS_TO_MANAGE=example.com,www.example.com

# Optional email (IMAP with app password only — never main password)
# EMAIL_IMAP_SERVER=imap.example.com
# EMAIL_IMAP_USER=you@example.com
# EMAIL_IMAP_APP_PASSWORD=your_app_password
